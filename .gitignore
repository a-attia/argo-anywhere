# macOS noise
.DS_Store
._*

# Editor backup / swap files
*~
*.swp
*.swo
.#*
\#*\#

# Backup files the script writes (timestamped <orig>.bak.<YYYYMMDD-HHMMSS>)
*.bak.*

# Python bytecode (none expected here, but defensive)
*.pyc
__pycache__/

# P1 spike virtualenv (never commit the venv; deps are declared, not vendored)
spike/.venv/

# Python package build artifacts + dev virtualenv (Model A; D-026)
.venv/
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/

# State / local config that should never be committed
.argo_opencode.server.log
.argo_opencode.sh

# IDE / editor / agent-client metadata (per-user, machine-local)
.idea/
.vscode/
.aider*
.claude/
